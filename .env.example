# Required: PostgreSQL connection used by the backend and Alembic.
DATABASE_URL=postgresql+psycopg://dfir:change-me@localhost:5432/dfir

# Development-safe local storage roots. Evidence and reports are kept separate.
EVIDENCE_ROOT=./data/cases
REPORT_ROOT=./data/exports
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Docker Compose database provisioning (replace for non-local deployments).
POSTGRES_DB=dfir
POSTGRES_USER=dfir
POSTGRES_PASSWORD=change-me
VITE_API_BASE_URL=http://localhost:8000

